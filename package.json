{
  "name": "sblms-library-system",
  "version": "1.0.0",
  "private": true,
  "description": "Shree Bala Ji Adhyayan Kendra Library Management System (SBLMS)",
  "scripts": {
    "dev": "concurrently -n \"flask,vite\" -c \"blue,green\" \"python backend/run.py\" \"npm run dev --prefix frontend\"",
    "dev:backend": "python backend/run.py",
    "dev:frontend": "npm run dev --prefix frontend",
    "build": "npm run build --prefix frontend",
    "test:backend": "python -m pytest backend/tests -v",
    "install:frontend": "npm install --prefix frontend"
  },
  "devDependencies": {
    "concurrently": "^9.1.2"
  }
}
