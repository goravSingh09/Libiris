# SBLMS Environment Configuration
FLASK_APP=run.py
FLASK_DEBUG=false
PORT=5000

# Security (Change in production)
SECRET_KEY=replace_with_a_secure_random_production_secret_key
JWT_SECRET_KEY=replace_with_a_secure_jwt_secret_key
JWT_EXPIRATION_HOURS=24

# Database
# For SQLite (local development): leave empty
# For PostgreSQL (production): postgresql://user:password@host:port/sblms_db
DATABASE_URL=

# Document Storage (Default: backend/storage/uploads)
STORAGE_FOLDER=

# Allowed CORS Origins (comma-separated)
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,https://your-frontend-domain.vercel.app

# SMTP Email Configuration (Optional for notifications & reminders)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_USE_TLS=true
SMTP_DEFAULT_SENDER=Shree Bala Ji Library <noreply@sblms.library>
