# Server Configuration
PORT=5000
NODE_ENV=development

# Database Connection (MongoDB Atlas Connection String)
# Example: mongodb+srv://<username>:<password>@cluster0.abcde.mongodb.net/libris?retryWrites=true&w=majority
DATABASE_URL=

# Security & Authentication
JWT_SECRET=your_jwt_super_secret_key_change_in_production
JWT_EXPIRES_IN=7d

# CORS Allowed Client Origin
CLIENT_URL=http://localhost:5173
